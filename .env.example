# ─── AZKT Command — environment ───────────────────────────────────────────
# Copy to .env and fill. Never commit .env.

# Postgres (source of truth)
DATABASE_URL=postgresql+asyncpg://azkt:azkt@127.0.0.1:5432/azkt_command

# Backend bind — LOOPBACK ONLY. Public access is via the reverse proxy.
API_HOST=127.0.0.1
API_PORT=8787

# Public origin of the dashboard (used for WebAuthn RP ID + CORS)
PUBLIC_ORIGIN=https://dash.arizonakeitrucks.com
WEBAUTHN_RP_ID=dash.arizonakeitrucks.com
WEBAUTHN_RP_NAME=AZKT Command

# First-registration gate. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# The first passkey can only be registered by presenting this token.
SETUP_TOKEN=CHANGE_ME_ONE_TIME_SETUP_TOKEN

# Session signing
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX

# Notion mirror
NOTION_TOKEN=secret_xxx
NOTION_VEHICLES_DB_ID=
NOTION_CUSTOMERS_DB_ID=
NOTION_IRQS_DB_ID=
# Notion -> dashboard reflection poll interval (seconds). Spec: within a minute.
NOTION_POLL_SECONDS=45

# OpenClaw
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_CLI=openclaw
# Root where per-agent state lives (sessions transcripts used for usage backfill)
OPENCLAW_HOME=/root/.openclaw

# Email forbidden-recipient guard (enforced now even though email send is post-v1)
FORBIDDEN_RECIPIENTS=wordpress@azkeitrucks.com

# Default business partition for every business-data row
DEFAULT_BUSINESS_ID=AZKT

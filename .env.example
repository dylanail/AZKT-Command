# ─── AZKT — environment (copy to .env; never commit .env) ───────────────────
# Every value below is a setup input. Nothing is guessed; blank = feature held
# in setup-blocked state and reported as such in Settings → Connections.

# Outside ENV=production, delivering transports may only reach these destinations (emails, @domains, chat ids, URL prefixes).
NON_PROD_DESTINATION_ALLOWLIST=
ENV=development                      # development | staging | production
DATABASE_URL=postgresql+asyncpg://azkt@127.0.0.1:5432/azkt_command
TEST_DATABASE_URL=postgresql+asyncpg://azkt@127.0.0.1:5432/azkt_test
API_HOST=0.0.0.0                     # Railway: 0.0.0.0 ; droplet: 127.0.0.1 behind nginx
API_PORT=8787
PUBLIC_ORIGIN=https://dash.arizonakeitrucks.com
PUBLIC_API_BASE=                     # empty = same origin
DATA_DIR=./data                      # local file storage in dev
DEFAULT_TIMEZONE=America/Phoenix
LOG_LEVEL=info

# Auth
WEBAUTHN_RP_ID=dash.arizonakeitrucks.com
WEBAUTHN_RP_NAME=AZKT
SETUP_TOKEN=CHANGE_ME_ONE_TIME_SETUP_TOKEN   # python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX
ENCRYPTION_KEY=                      # Fernet key for stored provider tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# Worker / scheduling
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
DIGEST_DEFAULT_LOCAL_TIME=08:00

# Model runtime (Anthropic). Discretionary AI work stays off until a budget is set.
ANTHROPIC_API_KEY=
AZKT_MODEL=claude-opus-5
AZKT_MODEL_LIGHT=claude-sonnet-5
AZKT_MODEL_EFFORT=high
MODEL_DAILY_BUDGET_USD=0
MODEL_MONTHLY_BUDGET_USD=0

# Email reminders (owner destination must be verified in Settings before sends)
EMAIL_TRANSPORT=log                  # log | smtp | gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REMINDER_FROM=AZKT <reminders@azkt.app>
OWNER_REMINDER_EMAIL=
FORBIDDEN_RECIPIENTS=wordpress@azkeitrucks.com

# Telegram private owner channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=             # X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_USERNAME=

# Google (Gmail business + personal allowlist, Drive, Sheets, Calendar) — server-side OAuth.
# Calendar needs no variable of its own: the owner connects it in Settings → Calendar with the same
# client, and creating events is an explicit capability stored in the database, not an env switch.
# Consent screen must list calendar.readonly (day view + clash detection) and calendar.events (create).
# Outside ENV=production a calendar write is refused unless the calendar id is in
# NON_PROD_DESTINATION_ALLOWLIST, so staging can never touch the real business calendar (H08).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
BUSINESS_EMAIL=info@azkeitrucks.com

# Square
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_NOTIFICATION_URL=
SQUARE_ENVIRONMENT=sandbox

# WordPress / WooCommerce (read/discovery first; writes need separate activation)
WP_BASE_URL=
WP_STAGING_URL=
WP_APP_USER=
WP_APP_PASSWORD=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# File storage.
# On Railway the container filesystem is replaced on every deploy, so `local` with no mounted volume
# loses every uploaded photo — and the damage only shows up later, when an approved listing has no
# photo bytes to upload to WooCommerce. Either set STORAGE_BACKEND=s3 with the S3_* values below, or
# mount a volume and point DATA_DIR inside it. /api/health reports storage.durable.
STORAGE_BACKEND=local                # local | s3
# DATA_DIR=/data/azkt                # unset = <repo>/data. On Railway set this inside the volume mount.
#                                      Leave it commented out rather than empty: an empty value is a path.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MAX_BYTES=26214400

# Legacy droplet adapters (Notion mirror, OpenClaw shims) — off by default
LEGACY_BACKGROUND_LOOP=false
NOTION_TOKEN=
NOTION_VEHICLES_DB_ID=
NOTION_CUSTOMERS_DB_ID=
NOTION_IRQS_DB_ID=
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOME=/root/.openclaw
DEFAULT_BUSINESS_ID=AZKT

# ── Optional model-adjacent services (all off when unset; features report setup_blocked, never fake output) ──
# Voice transcription endpoint for intake and Manager voice notes (POST audio → {"text": ...}). Unset = typed-entry fallback.
TRANSCRIBE_URL=
TRANSCRIBE_TOKEN=
# Embeddings endpoint for knowledge retrieval (pgvector optional; lexical search is used when unset).
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_TOKEN=
# Auction/source feed for sourcing candidates (unset = manual candidate entry only).
AUCTION_SOURCE_URL=
AUCTION_SOURCE_KEY=

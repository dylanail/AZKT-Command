# Only the reverse proxy is public. Backend + agents stay on loopback.
# dash.arizonakeitrucks.com  -> static PWA bundle (added in frontend phase)
# api.arizonakeitrucks.com   -> 127.0.0.1:8787 (FastAPI)

server {
    listen 443 ssl http2;
    server_name api.arizonakeitrucks.com;

    # ssl_certificate / ssl_certificate_key via certbot

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl http2;
    server_name dash.arizonakeitrucks.com;

    # ssl_certificate / ssl_certificate_key via certbot

    # Interim (no Vite build on the box yet): the backend serves a minimal
    # build-free passkey enrollment page at / and /enroll, plus /auth + /api.
    # WebAuthn requires this to be reached on the dash.* origin, so proxy it
    # here exactly like the api host. Cookies stay first-party (same origin).
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Frontend phase: once `npm run build` produces frontend/dist, replace the
    # location / above with the static bundle and proxy only the API paths:
    #
    #   root /opt/azkt-command/frontend/dist;
    #   location / { try_files $uri /index.html; }
    #   location /auth { proxy_pass http://127.0.0.1:8787; }
    #   location /api  { proxy_pass http://127.0.0.1:8787; }
}

# The four agent shims (ports from config/agents.yaml) and the FastAPI app
# are NOT given server blocks — they bind 127.0.0.1 and are never exposed.

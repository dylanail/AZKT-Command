# Only the reverse proxy is public. Backend + agents stay on loopback.
# dash.arizonakeitrucks.com  -> static PWA bundle (added in frontend phase)
# api.arizonakeitrucks.com   -> 127.0.0.1:8787 (FastAPI)

server {
    listen 443 ssl http2;
    server_name api.arizonakeitrucks.com;

    # ssl_certificate / ssl_certificate_key via certbot

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl http2;
    server_name dash.arizonakeitrucks.com;

    # ssl_certificate / ssl_certificate_key via certbot

    # The SPA bundle is the dashboard. `scripts/deploy.sh` runs `npm run
    # build` so frontend/dist exists; serve it at / with an index.html
    # fallback so client-side routes (passkey login -> dashboard) resolve
    # instead of hitting the backend's setup page.
    root /opt/azkt-command/frontend/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Build-free passkey page fallback (used before the bundle exists, or
    # for adding a device from a bare browser). Must stay on this origin.
    location = /enroll {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /auth {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /api {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

# The four agent shims (ports from config/agents.yaml) and the FastAPI app
# are NOT given server blocks — they bind 127.0.0.1 and are never exposed.
